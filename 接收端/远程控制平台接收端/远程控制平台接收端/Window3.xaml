<Window x:Class="远程控制平台接收端.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="远程控制平台接收端"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        SizeToContent="Height"
        ResizeMode="NoResize"
        MaxWidth="800"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Border CornerRadius="15" Background="#86000000" Margin="20">
        <Grid x:Name="MainGrid">
            <Grid.Clip>
                <RectangleGeometry x:Name="ClipGeometry" RadiusX="15" RadiusY="15"/>
            </Grid.Clip>
            <Grid.RowDefinitions>
                <!-- 进度条行 -->
                <RowDefinition x:Name="ProgressRow" Height="Auto"/>
                <!-- 顶部栏 -->
                <RowDefinition Height="Auto"/>
                <!-- 内容区 -->
                <RowDefinition Height="*"/>
                <!-- 底部留空 -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 进度条 -->
            <Rectangle x:Name="TimeProgressBar"
                       Grid.Row="0"
                       Height="6"
                       HorizontalAlignment="Left"
                       Width="0"
                       Fill="#4FFFFF"
                       Visibility="Collapsed"/>

            <!-- 顶部栏：用户信息和关闭按钮 -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 用户信息 -->
                <TextBlock x:Name="UserInfoTextBlock" 
                           Text="用户信息"
                           Foreground="#FF3399FF"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="20,15,20,10"
                           TextWrapping="Wrap"/>

                <!-- 关闭按钮（右上角） -->
                <Image x:Name="CloseButton"
                       Grid.Column="1"
                       Source="Assets/x.png"
                       Margin="0,14,15,0"
                       Opacity="0.5"
                       Cursor="Hand"
                       VerticalAlignment="Top"/>
            </Grid>

            <!-- 打字机模式：始终左对齐 -->
            <ScrollViewer x:Name="MessageScrollViewer"
                          Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="20,10,20,20"
                          FocusVisualStyle="{x:Null}"
                          Focusable="False">
                <TextBlock x:Name="MessageTextBlock"
                           Text="等待消息..."
                           Foreground="White"
                           FontSize="32"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Left"
                           TextAlignment="Left"/>
            </ScrollViewer>

            <!-- 底部留空 -->
            <Border Grid.Row="3" Height="10" Background="Transparent"/>
        </Grid>
    </Border>
</Window>