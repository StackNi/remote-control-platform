<?xml version="1.0" encoding="utf-8"?>
<Window 
	x:Class="远程控制平台接收端.Window1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Broadcast Receiver"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    ShowInTaskbar="False"
    Topmost="True"
    Closing="Window_Closing"
    Height="206"
    ResizeMode="NoResize"
    MouseLeftButtonDown="Window_MouseLeftButtonDown"
    Loaded="Window_Loaded">
	<Window.Resources>
		<Style TargetType="Label">
			<Setter Property="Foreground" Value="White" />
			<Setter Property="FontWeight" Value="Bold" />
		</Style>
	</Window.Resources>
	<Border
		x:Name="MessageBorder"
		CornerRadius="15"
		Background="#86000000"
		Margin="6"
		VerticalAlignment="Top"
		Height="150">
		<Grid x:Name="MainGrid">
			<Grid.Clip>
				<RectangleGeometry x:Name="ClipGeometry" RadiusX="15" RadiusY="15"/>
			</Grid.Clip>
			<Grid.RowDefinitions>
				<!-- 进度条行 -->
				<RowDefinition x:Name="ProgressRow" Height="Auto"/>
				<!-- 顶部栏 -->
				<RowDefinition Height="Auto"/>
				<!-- 消息内容 -->
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- 进度条 -->
			<Rectangle x:Name="TimeProgressBar"
					   Grid.Row="0"
					   Height="6"
					   HorizontalAlignment="Left"
					   Width="0"
					   Fill="#4FFFFF"
					   Visibility="Collapsed"/>

			<!-- 顶部栏：用户信息和关闭按钮 -->
			<Grid Grid.Row="1">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<!-- 用户信息（左上角） -->
				<StackPanel Orientation="Horizontal" Margin="10,5,0,0">
					<Label
						x:Name="UserInfoLabel"
						Content="用户信息"
						Foreground="#FF3399FF"
						VerticalAlignment="Center"
						FontSize="20" />
				</StackPanel>

				<!-- 关闭按钮（右上角） -->
				<Image x:Name="CloseButton"
					   Grid.Column="1"
					   Source="Assets/x.png"
					   Margin="0,5,10,0"
					   Opacity="0.5"
					   Cursor="Hand">
				</Image>
			</Grid>

			<!-- 消息内容 -->
			<Canvas
				x:Name="MessageCanvas"
				ClipToBounds="True"
				Grid.Row="2">
				<!-- 消息标签将通过代码动态创建 -->
			</Canvas>
		</Grid>
	</Border>
</Window>